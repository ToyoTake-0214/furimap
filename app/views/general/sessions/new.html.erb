<% content_for(:title, t(".title")) %>
<div class="min-h-screen bg-base-100">
  <div class="mx-auto max-w-3xl px-6 py-24">
    <%= link_to "← 戻る", root_path, class: "btn btn-ghost btn-sm -ml-2 mb-4" %>

    <h1 class="mb-6 text-3xl font-bold">
      ユーザーログイン
    </h1>

    <%= link_to "初めて登録されるユーザーはこちら",
                new_general_registration_path,
                class: "btn btn-error mb-4 w-full text-lg font-normal text-black" %>

    <%= link_to "フリマ主催者はこちら",
                new_user_session_path,
                class: "btn btn-outline mb-12 w-full text-lg font-normal" %>

    <h2 class="mb-6 text-3lg font-bold">
      メールアドレスとパスワードでログイン
    </h2>

    <%= form_for(resource,
                 as: resource_name,
                 url: general_session_path) do |f| %>

      <%= f.hidden_field :role, value: "general" %>

      <div class="form-control mb-6">
        <%= f.label :email,
                    class: "label justify-start" %>

        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          class: "input input-bordered h-16 w-full bg-base-200 text-lg" %>
      </div>

      <div class="form-control mb-6">
        <%= f.label :password,
                    class: "label justify-start" %>

        <%= f.password_field :password,
                             autocomplete: "current-password",
                             class: "input input-bordered h-16 w-full bg-base-200 text-lg" %>
      </div>

      <div class="text-center">
        <%= f.submit t(".sign_in"),
                     class: "btn btn-success w-full max-w-xs text-lg font-normal text-black" %>
      </div>
    <% end %>
  </div>
</div>
