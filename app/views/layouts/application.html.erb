<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title(yield(:title)) %></title>
    <meta name="description" content="<%= page_description(yield(:description)) %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# OGP: X(Twitter)やLINEなどでシェアされた際のプレビュー用タグ %>
    <meta property="og:title" content="<%= page_title(yield(:title)) %>">
    <meta property="og:description" content="<%= page_description(yield(:description)) %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:site_name" content="フリマップ">
    <meta property="og:image" content="<%= "#{request.base_url}/icon.png" %>">
    <meta property="og:locale" content="ja_JP">

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= favicon_link_tag("favicon.ico") %>
  </head>

  <body class="flex min-h-screen flex-col">
    <% if user_signed_in? %>
      <%= render 'shared/header' %>
    <% else %>
      <%= render 'shared/before_login_header' %>
    <% end %>

    <%# deivseのフラッシュメッセージを表示 %>
    <% if notice.present? %>
      <div class="alert alert-success mx-4 mt-2 w-auto" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span><%= notice %></span>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="alert alert-error mx-4 mt-2 w-auto" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
        <span><%= alert %></span>
      </div>
    <% end %>

    <main class="flex flex-1 flex-col">
      <%= yield %>
    </main>

    <%= render 'shared/footer' %>
  </body>
</html>
