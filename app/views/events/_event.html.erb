<div class="card min-h-56 border border-dashed border-base-300 bg-base-100 shadow-sm">
  <div class="card-body">
    <div>
      <h2 class="text-2xl font-bold">
        <%= event.name %>
      </h2>

      <div class="mt-2">
        <% event.event_schedules.order(:event_date).each do |schedule| %>
          <p class="text-base-content/70">
            <%= schedule.event_date %>
          </p>
        <% end %>
      </div>
    </div>

    <div class="card-actions mt-auto justify-end">
      <%= link_to "編集",
                  edit_event_path(event),
                  class: "btn btn-sm btn-outline" %>

      <%= link_to "削除",
                  "#",
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "このイベントを削除しますか？"
                  },
                  class: "btn btn-sm btn-error btn-outline" %>
    </div>
  </div>
</div>
