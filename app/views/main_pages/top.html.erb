<div class="flex justify-center items-center gap-4">

  <select id="prefecture-select" class="select">
    <% @prefectures.each do |pref| %>
      <option value="<%= pref["name"] %>" data-lat="<%= pref["lat"] %>" data-lng="<%= pref["lng"] %>">
        <%= pref["name"] %>
      </option>
    <% end %>
  </select>

  <button id="btn" class="btn">現在地へ移動</button>
</div>


<div id="map" style="height: 600px;"></div>

<script>
  function initMap() {
    // 地図要素を取得する

    const mapElement = document.getElementById('map');
    const btnElement = document.getElementById('btn');
    const selectElement = document.getElementById('select');

    const mapOptions = {
      center: {lat: 35.6636, lng: 139.6978},
      zoom: 8
    };
    // 地図を表示
    const map = new google.maps.Map(mapElement, mapOptions);

    // マーカーを表示
    <% @events.each do |event| %>

      var markerLatLng = new google.maps.LatLng({lat: <%= event.latitude %>, lng: <%= event.longitude %>});
      var marker = new google.maps.Marker({ // マーカーの追加
        position: markerLatLng, // マーカーを立てる位置を指定
        map: map // マーカーを立てる地図を指定
      });

    <% end %>

    btnElement.addEventListener("click", () => {

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const { latitude, longitude } = pos.coords;

          map.panTo({ lat: latitude, lng: longitude });
          map.setZoom(12);
        }
      );
    });
    
    document.getElementById("prefecture-select").addEventListener("change", (e) => {
    const selected = e.target.selectedOptions[0];
    const lat = parseFloat(selected.dataset.lat);
    const lng = parseFloat(selected.dataset.lng);
    map.panTo({ lat, lng });
    map.setZoom(11) // 本来であれば各都道府県に適したズームを設定するのが最適であるが、MVP時点は11を固定
  });

  }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV["GOOGLE_MAPS_API_KEY"] %>&callback=initMap"></script>

