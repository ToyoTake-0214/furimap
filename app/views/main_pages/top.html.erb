<script id="map-locations-data" type="application/json"><%= raw json_escape(@locations_for_map.to_json) %></script>

<div class="flex flex-1 flex-col">
  <div class="flex flex-nowrap justify-center items-center my-2 gap-2 px-4 overflow-x-auto">
    <label for="event-date-search" class="text-sm text-base-content/60 whitespace-nowrap">開催日から探す</label>
    <input type="date" id="event-date-search" class="input">

    <select id="prefecture-select" class="select">
      <option value="" selected disabled>都道府県から探す</option>
      <% @prefectures.each do |pref| %>
        <option value="<%= pref["name"] %>" data-lat="<%= pref["lat"] %>" data-lng="<%= pref["lng"] %>">
          <%= pref["name"] %>
        </option>
      <% end %>
    </select> 
  </div>

  <div class="relative flex-1">
    <div id="map" class="absolute inset-0"></div>
    <button id="btn" class="btn btn-lg absolute top-4 left-4 z-10 rounded-full bg-red-300 hover:bg-red-400 border-none text-lg px-8 py-4">現在地へ移動</button>
  </div>
</div>

<dialog id="event-detail" class="modal">
  <div class="modal-box max-w-2xl max-h-[80vh] overflow-y-auto">
    <div class="sticky top-0 z-10 flex items-center justify-between gap-2 border-b border-base-200 bg-base-100 pb-3">
      <div class="flex items-center gap-2">
        <button id="event-detail-back" type="button" class="btn btn-sm btn-ghost hidden">
          ← 一覧に戻る
        </button>
        <h2 class="text-lg font-bold">フリマ情報</h2>
      </div>

      <button id="event-detail-close" type="button" class="btn btn-sm btn-circle btn-ghost">
        ✕
      </button>
    </div>

    <div id="event-detail-schedules" class="mt-4"></div>
  </div>
</dialog>

<template id="schedule-card-template">
  <div class="schedule-card card card-side bg-base-100 border border-base-200 shadow-sm cursor-pointer transition hover:shadow-md mb-3 relative">
    <figure class="w-32 shrink-0">
      <img class="event-image view-detail-link h-24 w-full object-cover" alt="">
    </figure>

    <div class="card-body p-4 pr-16">
      <p class="event-name font-bold"></p>
      <p class="text-sm text-base-content/60">
        <span class="text-base-content/50">開催日：</span><span class="event-date"></span>
      </p>
      <p class="view-detail-link text-xs text-base-content/50 text-right">詳細はこちら ›</p>
    </div>

    <div class="favorite-button-slot absolute top-2 right-2"></div>

  </div>
</template>

<template id="event-detail-template">
  <div>
    <div class="relative">
      <img class="detail-image w-full h-56 object-cover rounded-lg" alt="">
      <div class="favorite-button-slot absolute top-2 right-2"></div>
    </div>

    <h3 class="detail-name text-xl font-bold mt-4"></h3>

    <div class="mt-3 space-y-2">
      <p class="text-sm font-medium">
        <span class="text-base-content/50">開催日：</span><span class="detail-date"></span>
      </p>
      <p class="text-sm text-base-content/70">
        <span class="text-base-content/50">住所：</span><span class="detail-address"></span>
      </p>
    </div>

    <p class="mt-5 leading-relaxed whitespace-pre-line">
      <span class="text-base-content/50 font-semibold block mb-1">概要</span><span class="detail-description"></span>
    </p>
  </div>
</template>

<script>
  function initMap() {
    // 地図要素を取得
    const mapElement = document.getElementById("map");
    const btnElement = document.getElementById("btn");

    // 地図用データ
    const locationsDataElement = document.getElementById("map-locations-data");
    const locations = JSON.parse(locationsDataElement.textContent);

    // プレビュー用要素
    const eventDetail = document.getElementById("event-detail");
    const schedulesContainer = document.getElementById("event-detail-schedules");
    const scheduleTemplate = document.getElementById("schedule-card-template");
    const closeButton = document.getElementById("event-detail-close");
    const backButton = document.getElementById("event-detail-back");
    const eventDetailTemplate = document.getElementById("event-detail-template");

    // 検索用の検索情報
    const dateSearchElement = document.getElementById("event-date-search");

    // 一覧に戻るために、表示していた開催日カードの一覧を覚えておくための変数
    let currentSchedules = [];

    // 日本国内（離島含む）に収まる範囲。この範囲外への移動・縮小を制限する
    const JAPAN_BOUNDS = {
      north: 45.7,
      south: 20.3,
      west: 122.8,
      east: 154.0
    };

    const mapOptions = {
      center: { lat: 35.6636, lng: 139.6978 },
      zoom: 7,
      mapTypeControl: false,
      restriction: {
        latLngBounds: JAPAN_BOUNDS,
        strictBounds: true
      }
    };

    // 地図を表示
    const map = new google.maps.Map(mapElement, mapOptions);

    // 開催日カードを作る
    function buildScheduleCard(schedule) {
      const card = scheduleTemplate.content.cloneNode(true);

      const image = card.querySelector(".event-image");
      const name = card.querySelector(".event-name");
      const date = card.querySelector(".event-date");
      const favoriteButtonSlot = card.querySelector(".favorite-button-slot");

      image.src = schedule.event.image_url;
      image.alt = schedule.event.name;

      name.textContent = schedule.event.name;
      date.textContent = schedule.event_date;

      if (schedule.event.favorite_button_html) {
        favoriteButtonSlot.innerHTML = schedule.event.favorite_button_html;
      }

      return card;
    }
    // 詳細のカードを作る
    function buildScheduleDetail(schedule) {
      const detail = eventDetailTemplate.content.cloneNode(true);

      const detail_image = detail.querySelector(".detail-image");
      const detail_name = detail.querySelector(".detail-name");
      const detail_date = detail.querySelector(".detail-date");
      const detail_address = detail.querySelector(".detail-address");
      const detail_description = detail.querySelector(".detail-description");
      const favoriteButtonSlot = detail.querySelector(".favorite-button-slot");

      detail_image.src = schedule.event.image_url;
      detail_image.alt = schedule.event.name;

      detail_name.textContent = schedule.event.name;
      detail_date.textContent = schedule.event_date;
      detail_address.textContent = schedule.event.address;
      detail_description.textContent = schedule.event.description;

      if (schedule.event.favorite_button_html) {
        favoriteButtonSlot.innerHTML = schedule.event.favorite_button_html;
      }

      return detail;
    }

    // プレビューを表示
    function showSchedules(schedules) {
      currentSchedules = schedules;
      backButton.classList.add("hidden");
      schedulesContainer.replaceChildren();

      if (schedules.length === 0) {
        const emptyMessage = document.createElement("p");
        emptyMessage.textContent = "次の開催をお待ちください";
        emptyMessage.classList.add("text-center", "text-base-content/60", "py-6");

        schedulesContainer.appendChild(emptyMessage);
        eventDetail.showModal();

        return;
      }

      schedules.forEach((schedule) => {
        const card = buildScheduleCard(schedule);
        const viewDetailLinks = card.querySelectorAll(".view-detail-link");

        viewDetailLinks.forEach((element) => {
          element.addEventListener("click", () => {
            showScheduleDetail(schedule);
          });
        });

        schedulesContainer.appendChild(card);
      });

      eventDetail.showModal();
    }


    // 詳細プレビューを表示
    function showScheduleDetail(schedule) {
      const detail = buildScheduleDetail(schedule)

      backButton.classList.remove("hidden");
      schedulesContainer.replaceChildren(detail);
    }

    // 現在表示中のマーカーを覚えておく（描画し直すたびに前のマーカーを消すため）
    let markers = [];

    // 与えられたlocationsを元にマーカーを描画する
    function renderMarkers(locationsToShow) {
      // 前回描画したマーカーを地図から消す
      markers.forEach((marker) => marker.setMap(null));
      markers = [];

      locationsToShow.forEach((location) => {
        const marker = new google.maps.Marker({
          position: {
            lat: location.latitude,
            lng: location.longitude
          },
          map: map,
          icon: {
            url: "<%= asset_path('furima_marker.png') %>",
            scaledSize: new google.maps.Size(40, 60)
          }
        });

        marker.addListener("click", () => {
          showSchedules(location.schedules);
        });

        markers.push(marker);
      });
    }

    // 初期表示
    renderMarkers(filterLocations());

    // プレビューを閉じる
    closeButton.addEventListener("click", () => {
      eventDetail.close();
    });

    // ダイアログの外側（背景部分）をクリックしたら閉じる
    eventDetail.addEventListener("click", (e) => {
      if (e.target === eventDetail) {
        eventDetail.close();
      }
    });

    // 一覧に戻る
    backButton.addEventListener("click", () => {
      showSchedules(currentSchedules);
    });

    // 現在地へ移動
    btnElement.addEventListener("click", () => {
      navigator.geolocation.getCurrentPosition((pos) => {
        const { latitude, longitude } = pos.coords;

        map.panTo({ lat: latitude, lng: longitude });
        map.setZoom(12);
      });
    });

    // 都道府県へ移動
    document
      .getElementById("prefecture-select")
      .addEventListener("change", (e) => {
        const selected = e.target.selectedOptions[0];
        const lat = parseFloat(selected.dataset.lat);
        const lng = parseFloat(selected.dataset.lng);

        map.panTo({ lat, lng });
        map.setZoom(11);
      });

    // 開催日でlocationsを絞り込む
    function filterLocations() {
      const selectedDate = dateSearchElement.value;

      // 日付が選ばれていなければ、絞り込まず全件を返す
      if (!selectedDate) {
        return locations;
      }

      const filteredLocations = [];

      locations.forEach((location) => {
        const matchingSchedules = [];

        // このlocationのschedulesの中から、選んだ日付と一致するものだけ集める
        location.schedules.forEach((schedule) => {
          if (schedule.event_date === selectedDate) {
            matchingSchedules.push(schedule);
          }
        });

        // 一致する開催日が1つでもあれば、そのlocationを結果に追加する
        if (matchingSchedules.length > 0) {
          filteredLocations.push({
            latitude: location.latitude,
            longitude: location.longitude,
            schedules: matchingSchedules
          });
        }
      });
      return filteredLocations;
    }
    // 絞り込みを変更する
      dateSearchElement.addEventListener("change", () => {
        renderMarkers(filterLocations());
      });
  }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV["GOOGLE_MAPS_API_KEY"] %>&callback=initMap"></script>
