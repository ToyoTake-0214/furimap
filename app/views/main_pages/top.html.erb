<button id="btn" class="btn">現在地へ移動</button>
<div id="map" style="height: 600px;"></div>

<script>
  function initMap() {
    // 地図要素を取得する
    const mapElement = document.getElementById('map');
    const btnElement = document.getElementById('btn');

    const mapOptions = {
      center: {lat: 35.6636, lng: 139.6978},
      zoom: 8 
    };
    // 地図を表示
    const map = new google.maps.Map(mapElement, mapOptions);

    // マーカーを表示
    <% @events.each do |event| %>

      var markerLatLng = new google.maps.LatLng({lat: <%= event.latitude %>, lng: <%= event.longitude %>});
      var marker = new google.maps.Marker({ // マーカーの追加
        position: markerLatLng, // マーカーを立てる位置を指定
        map: map // マーカーを立てる地図を指定
      });

    <% end %>

    btnElement.addEventListener("click", () => {

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const { latitude, longitude } = pos.coords;

          map.panTo({ lat: latitude, lng: longitude });
          map.setZoom(12);
        }
      );
    });
  }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV["GOOGLE_MAPS_API_KEY"] %>&callback=initMap"></script>

