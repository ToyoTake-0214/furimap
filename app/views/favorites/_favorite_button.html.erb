<% if favorite %>
  <%= link_to favorite_path(favorite),
              data: { turbo_method: :delete },
              class: "favorite-button-event-#{event.id} btn btn-circle btn-ghost" do %>
    <!-- 保存済み：塗りつぶしの栞 -->
    <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
      <path d="M6.32 2.577a49.255 49.255 0 0 1 11.36 0c1.497.174 2.57 1.46 2.57 2.93V21a.75.75 0 0 1-1.085.67L12 18.089l-7.165 3.583A.75.75 0 0 1 3.75 21V5.507c0-1.47 1.073-2.756 2.57-2.93Z" />
    </svg>
  <% end %>
<% else %>
  <%= link_to favorites_path(event_id: event.id),
              data: { turbo_method: :post },
              class: "favorite-button-event-#{event.id} btn btn-circle btn-ghost" do %>
    <!-- 未保存：アウトラインの栞 -->
    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
        d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
    </svg>
  <% end %>
<% end %>
