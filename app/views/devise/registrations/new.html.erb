<div class="min-h-screen bg-base-100">
  <div class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="mb-10 text-3xl font-bold">
      主催者新規登録
    </h1>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name)) do |f| %>

      <%= render "devise/shared/error_messages",
                 resource: resource %>

      <div class="form-control mb-6">
        <%= f.label :email,
                    class: "label justify-start" %>

        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          class: "input input-bordered h-16 w-full bg-base-200 text-lg" %>
      </div>

      <div class="form-control mb-6">
        <div class="label justify-start gap-2">
          <%= f.label :password %>

          <% if @minimum_password_length %>
            <span class="text-sm text-base-content/60">
              <%= t("devise.shared.minimum_password_length",
                    count: @minimum_password_length) %>
            </span>
          <% end %>
        </div>

        <%= f.password_field :password,
                             autocomplete: "new-password",
                             class: "input input-bordered h-16 w-full bg-base-200 text-lg" %>
      </div>

      <div class="form-control mb-10">
        <%= f.label :password_confirmation,
                    class: "label justify-start" %>

        <%= f.password_field :password_confirmation,
                             autocomplete: "new-password",
                             class: "input input-bordered h-16 w-full bg-base-200 text-lg" %>
      </div>

      <div class="text-center">
        <%= f.submit t(".sign_up"),
                     class: "btn btn-success w-full max-w-xs text-lg font-normal text-black" %>
      </div>
    <% end %>
  </div>
</div>
